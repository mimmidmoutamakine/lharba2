<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force non-www canonical host (prevents CORS breakage on www.lharba.tech)
    RewriteCond %{HTTP_HOST} ^www\.lharba\.tech$ [NC]
    RewriteRule ^(.*)$ https://lharba.tech/$1 [L,R=301]

    # Fallback: allow cross-origin loading of static assets (fonts, JS, CSS, SVGs).
    # Ensures the page still works if the redirect above is not applied for any reason.
    <IfModule mod_headers.c>
        <FilesMatch "\.(woff2?|ttf|otf|eot|js|mjs|css|svg|png|jpe?g|gif|webp|ico)$">
            Header set Access-Control-Allow-Origin "*"
            Header set Access-Control-Allow-Methods "GET, OPTIONS"
            Header set Timing-Allow-Origin "*"
        </FilesMatch>
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
