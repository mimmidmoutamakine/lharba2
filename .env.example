# ═══════════════════════════════════════════════════════════════
# الهربة (Lharba) — environment template
# Copy to `.env` then fill in real values. Never commit `.env`.
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_NAME=Lharba
APP_ENV=production               # local | production
APP_KEY=                         # generate with: php artisan key:generate
APP_DEBUG=false                  # MUST be false in production
APP_URL=https://lharba.example.com
ASSET_URL=                       # leave blank unless serving assets from CDN

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_MA
APP_TIMEZONE=Africa/Casablanca

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                # debug locally, warning|error in prod

# ── Database (Hostinger MySQL) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                # usually 127.0.0.1 or "localhost" on Hostinger shared
DB_PORT=3306
DB_DATABASE=u123456789_lharba    # from hPanel → Databases
DB_USERNAME=u123456789_lharba    # from hPanel → Databases
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────
SESSION_DRIVER=database          # 'file' is also fine on shared hosting
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true       # https only — set false if site is http

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (use Hostinger SMTP, Resend, or similar) ─────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (only if you use S3 for storage; not needed by default) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Gemini AI (Schreiben corrector + generator) ──────────────
GEMINI_API_KEY=                  # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash-lite   # gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-flash-lite
GEMINI_TIMEOUT=60                # seconds

# ── Vite (build-time) ────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
